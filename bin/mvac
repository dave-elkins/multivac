#!/usr/bin/env bash
# mvac — multivac CLI. Common tasks, consistent conventions.
#
#   mvac wt clone <url> [dir]      clone a repo + set up its worktree root
#   mvac wt list                   worktrees: name, branch, path, status
#   mvac wt checkout <name>        print worktree path; create if missing
#   mvac wt cleanup [--dry-run] [--force]
#                                  remove merged, clean worktrees (asks first)
#   mvac sentencefmt [args...]     the canonical sentence-per-line formatter
#   mvac doctor                    health check (wraps install.sh --doctor)
#   mvac update                    git pull the multivac clone
#
# Conventions:
#   Worktrees live at <repo>/../.worktrees/<repo>/<name> (override the root
#   with MVAC_WT_ROOT). New worktrees get branch wt/<name>, created from the
#   default branch. The path is the only stdout of `wt checkout`, so it works
#   as: cd "$(mvac wt checkout my-feature)"
#
set -euo pipefail

MVAC_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

log()  { printf '  \033[1;32m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '  \033[1;33m->>\033[0m %s\n' "$*" >&2; }
die()  { printf '  \033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

have() { command -v "$1" >/dev/null 2>&1; }

require_repo() {
    git rev-parse --show-toplevel >/dev/null 2>&1 \
        || die "Run this inside a git repository."
}

default_branch() {
    # origin/HEAD if set, else main, else master, else empty.
    local b
    b="$(git symbolic-ref --short --quiet refs/remotes/origin/HEAD 2>/dev/null \
        | sed 's|^origin/||' || true)"
    if [ -z "$b" ]; then
        for b in main master; do
            git show-ref --verify --quiet "refs/heads/$b" 2>/dev/null && { printf '%s\n' "$b"; return 0; }
        done
        return 0
    fi
    printf '%s\n' "$b"
}

wt_repo_root() {
    # Parent directory holding this repo's worktrees.
    local root name
    root="$(git rev-parse --show-toplevel)"
    name="$(basename "$root")"
    if [ -n "${MVAC_WT_ROOT:-}" ]; then
        printf '%s/%s\n' "$MVAC_WT_ROOT" "$name"
    else
        printf '%s/.worktrees/%s\n' "$(dirname "$root")" "$name"
    fi
}

# Emit "path<TAB>branch" per worktree. Branch is empty for detached/bare.
wt_list_entries() {
    git worktree list --porcelain | awk '
        /^worktree / { path = substr($0, 10) }
        /^branch /   { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
        /^$/ { if (path != "") { printf "%s\t%s\n", path, branch; path = ""; branch = "" } }
        END { if (path != "") printf "%s\t%s\n", path, branch }
    '
}

is_dirty() { [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }

is_merged() {
    # $1 = branch name, $2 = default branch
    [ -n "$1" ] && [ -n "$2" ] \
        && git merge-base --is-ancestor "refs/heads/$1" "$2" 2>/dev/null
}

ask() {
    # Ask a yes/no question. Default no. No tty means no.
    local reply
    printf '%s [y/N] ' "$1" >&2
    if [ -t 0 ]; then
        read -r reply || return 1
    elif ! read -r reply 2>/dev/null </dev/tty; then
        return 1
    fi
    case "$reply" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

cmd_wt_clone() {
    [ $# -ge 1 ] || die "usage: mvac wt clone <url> [dir]"
    local url="$1" dir name root
    name="$(basename "$url" .git)"
    if [ $# -ge 2 ]; then
        dir="$2"
    elif [ -d "$HOME/code" ]; then
        dir="$HOME/code/$name"
    else
        dir="$PWD/$name"
    fi
    if [ -d "$dir/.git" ]; then
        log "Repo already cloned at $dir"
    elif [ -e "$dir" ]; then
        die "$dir exists but is not a clone. Move it aside or pick another dir."
    else
        log "Cloning $url to $dir"
        git clone "$url" "$dir"
    fi
    if [ -n "${MVAC_WT_ROOT:-}" ]; then
        root="$MVAC_WT_ROOT/$name"
    else
        root="$(dirname "$dir")/.worktrees/$name"
    fi
    mkdir -p "$root"
    log "Worktrees for this repo will live under: $root"
    log "Next: cd $dir && mvac wt checkout <name>"
}

cmd_wt_list() {
    require_repo
    local default
    default="$(default_branch)"
    local path branch name flags first
    first=1
    while IFS=$'\t' read -r path branch; do
        flags=""
        if is_dirty "$path"; then flags="dirty"; fi
        # 'merged' is meaningless for the main worktree's own branch.
        if [ "$first" = 0 ] && is_merged "$branch" "$default"; then
            [ -n "$flags" ] && flags="$flags "
            flags="${flags}merged"
        fi
        first=0
        name="$(basename "$path")"
        printf '%-16s %-14s %-40s %s\n' "$name" "${branch:--}" "$path" "$flags" >&2
    done < <(wt_list_entries)
    [ -n "$default" ] && log "default branch: $default"
}

cmd_wt_checkout() {
    require_repo
    local name="${1:-}"
    if [ -z "$name" ]; then
        cmd_wt_list
        die "usage: mvac wt checkout <name>   (creates branch wt/<name> if missing)"
    fi
    local root target base
    root="$(wt_repo_root)"
    target="$root/$name"
    if git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1; then
        # Print path only. Everything else goes to stderr.
        printf '%s\n' "$target"
        return 0
    fi
    if [ -e "$target" ]; then
        die "$target exists but is not a worktree of this repo."
    fi
    mkdir -p "$root"
    if git show-ref --verify --quiet "refs/heads/wt/$name"; then
        log "Reusing existing branch wt/$name"
        git worktree add "$target" "wt/$name" >/dev/null
    else
        base="$(default_branch)"
        base="${base:-HEAD}"
        log "Creating worktree '$name' on branch wt/$name from $base"
        git worktree add -b "wt/$name" "$target" "$base" >/dev/null
    fi
    printf '%s\n' "$target"
}

cmd_wt_cleanup() {
    require_repo
    local dry=0 force=0 a
    for a in "$@"; do
        case "$a" in
            --dry-run) dry=1 ;;
            --force)   force=1 ;;
            *) die "unknown option: $a (use --dry-run or --force)" ;;
        esac
    done
    git worktree prune
    local default path branch name dirty merged eligible first status
    default="$(default_branch)"
    [ -n "$default" ] || warn "Could not find a default branch; 'merged' check is off."
    first=1
    while IFS=$'\t' read -r path branch; do
        # Skip the main worktree (always first in the porcelain list).
        if [ "$first" = 1 ]; then first=0; continue; fi
        name="$(basename "$path")"
        dirty=0; is_dirty "$path" && dirty=1
        merged=0; is_merged "$branch" "$default" && merged=1
        eligible=1
        if [ "$force" = "0" ]; then
            eligible=0
            [ "$dirty" = "0" ] && [ "$merged" = "1" ] && eligible=1
        fi
        status=""
        [ "$dirty" = 1 ] && status="$status dirty"
        [ "$merged" = 1 ] && status="$status merged"
        if [ "$eligible" = 1 ]; then
            log "$name:$status — eligible for removal"
        else
            warn "$name:$status — skipped (clean+merged required, or use --force)"
        fi
        [ "$dry" = 1 ] && continue
        [ "$eligible" = 1 ] || continue
        if [ "$force" = 1 ] || ask "Remove worktree '$name'$( [ -n "$branch" ] && printf ' and delete branch %s' "$branch" )?"; then
            if [ "$dirty" = 1 ]; then
                git worktree remove --force "$path"
            else
                git worktree remove "$path"
            fi
            log "Removed worktree $name"
            if [ -n "$branch" ] && git show-ref --verify --quiet "refs/heads/$branch"; then
                if [ "$merged" = 1 ]; then
                    git branch -d "$branch"
                else
                    git branch -D "$branch"
                fi
                log "Deleted branch $branch"
            fi
        else
            log "Kept $name"
        fi
    done < <(wt_list_entries)
    git worktree prune
    if [ "$dry" = 1 ]; then
        log "Dry run. Nothing was removed."
    fi
}

cmd_sentencefmt() {
    exec python3 "$MVAC_HOME/tools/sentencefmt.py" "$@"
}

main() {
    local cmd="${1:-help}"
    case "$cmd" in
        wt)
            [ $# -ge 2 ] || die "usage: mvac wt <clone|list|checkout|cleanup> ..."
            local sub="$2"
            shift 2
            case "$sub" in
                clone)    cmd_wt_clone "$@" ;;
                list)     cmd_wt_list ;;
                checkout) cmd_wt_checkout "$@" ;;
                cleanup)  cmd_wt_cleanup "$@" ;;
                *) die "unknown wt subcommand: $sub (clone|list|checkout|cleanup)" ;;
            esac
            ;;
        sentencefmt) shift; cmd_sentencefmt "$@" ;;
        doctor)      exec "$MVAC_HOME/install.sh" --doctor ;;
        update)
            git -C "$MVAC_HOME" pull --ff-only
            log "multivac updated to $(git -C "$MVAC_HOME" rev-parse --short HEAD)"
            ;;
        help|-h|--help) usage 0 ;;
        *) die "unknown command: $cmd (try: mvac help)" ;;
    esac
}

main "$@"
